<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ICSPL Export" Width="660" Height="740" MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="12">
  <DockPanel Margin="12">

    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="ICSPL Export" FontSize="16" FontWeight="SemiBold"/>
      <TextBlock x:Name="model_text" Foreground="Gray" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>

      <GroupBox Header="1. Formats" Padding="6,4">
        <StackPanel>
          <WrapPanel>
            <CheckBox x:Name="chk_pdf" Content="PDF" Margin="0,2,20,2"/>
            <CheckBox x:Name="chk_dwg" Content="DWG (CAD)" Margin="0,2,20,2"/>
            <CheckBox x:Name="chk_nwc" Content="NWC" Margin="0,2,20,2"/>
            <CheckBox x:Name="chk_ifc" Content="IFC" Margin="0,2,20,2"/>
          </WrapPanel>
          <StackPanel x:Name="pdf_row" Orientation="Horizontal" Margin="0,6,0,2">
            <TextBlock Text="PDF setup" Width="105" VerticalAlignment="Center"/>
            <ComboBox x:Name="pdf_combo" Width="340"/>
          </StackPanel>
          <StackPanel x:Name="dwg_row" Orientation="Horizontal" Margin="0,6,0,2">
            <TextBlock Text="DWG setup" Width="105" VerticalAlignment="Center"/>
            <ComboBox x:Name="dwg_combo" Width="340"/>
          </StackPanel>
          <StackPanel x:Name="ifc_row" Orientation="Horizontal" Margin="0,6,0,2">
            <TextBlock Text="IFC setup" Width="105" VerticalAlignment="Center"/>
            <TextBlock x:Name="ifc_setup_text" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel x:Name="nwc_row" Orientation="Horizontal" Margin="0,6,0,2">
            <TextBlock x:Name="view_label" Text="3D view" Width="105" VerticalAlignment="Center"/>
            <ComboBox x:Name="nwc_combo" Width="340"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="2. Folder" Padding="6,4" Margin="0,8,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Main folder" VerticalAlignment="Center"/>
          <TextBox x:Name="folder_box" Grid.Row="0" Grid.Column="1" Padding="2" VerticalContentAlignment="Center"/>
          <Button x:Name="browse_btn" Grid.Row="0" Grid.Column="2" Content="Browse..." Padding="10,2" Margin="6,0,0,0"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Initials" VerticalAlignment="Center" Margin="0,6,0,0"/>
          <TextBox x:Name="initials_box" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                   Padding="2" Margin="0,6,0,0"/>
          <TextBlock x:Name="new_folder_text" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                     Margin="0,6,0,0" TextWrapping="Wrap" Foreground="Gray"/>
        </Grid>
      </GroupBox>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="pdf_text" TextWrapping="Wrap" Foreground="Gray"/>
      <TextBlock x:Name="status_text" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,6,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button x:Name="export_btn" Content="Export" Width="90" Padding="0,3" IsDefault="True"/>
        <Button x:Name="cancel_btn" Content="Cancel" Width="90" Padding="0,3" Margin="8,0,0,0" IsCancel="True"/>
      </StackPanel>
    </StackPanel>

    <GroupBox x:Name="sheets_group" Header="3. Sheets" Padding="6,4" Margin="0,8,0,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="rb_pick" GroupName="sheet_source" Content="Pick from list" Margin="0,2"/>
          <RadioButton x:Name="rb_browser" GroupName="sheet_source" Content="Selected in Browser" Margin="0,2"/>
          <StackPanel Orientation="Horizontal" Margin="0,2">
            <RadioButton x:Name="rb_set" GroupName="sheet_source" Content="Revit Sheet Set" VerticalAlignment="Center"/>
            <ComboBox x:Name="set_combo" Width="300" Margin="10,0,0,0"/>
          </StackPanel>
          <Grid Margin="0,6,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Search" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="search_box" Grid.Column="1" Padding="2"/>
            <Button x:Name="all_btn" Grid.Column="2" Content="Tick all" Padding="8,1" Margin="6,0,0,0"/>
            <Button x:Name="none_btn" Grid.Column="3" Content="Untick all" Padding="8,1" Margin="6,0,0,0"/>
          </Grid>
        </StackPanel>
        <TextBlock x:Name="count_text" DockPanel.Dock="Bottom" Margin="0,4,0,0"/>
        <Border BorderBrush="#FFABADB3" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="sheet_panel" Margin="4,2"/>
          </ScrollViewer>
        </Border>
      </DockPanel>
    </GroupBox>

  </DockPanel>
</Window>
